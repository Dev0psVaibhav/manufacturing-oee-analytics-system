# Set default behavior to automatically normalize line endings
* text=auto

# Source code and configuration files
*.java text diff=java eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.json text eol=lf

# Executable wrapper scripts
mvnw text eol=lf
mvnw.cmd text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Binary files
*.jar binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.ico binary
