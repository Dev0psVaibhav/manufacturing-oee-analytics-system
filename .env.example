# ==============================================================================
# Manufacturing OEE Analytics System - Environment Configuration Template
# Copy this file to .env or export these variables in your terminal before running.
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Spring Environment Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Application HTTP Port
SERVER_PORT=8080
SERVER_CONTEXT_PATH=

# Local MySQL 8.x Database Connectivity Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manufacturing_oee
DB_USERNAME=root
DB_PASSWORD=Password@123

# Complete JDBC Connection URL (Overridden if individual host/port/name are supplied)
DB_URL=jdbc:mysql://localhost:3306/manufacturing_oee?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# HikariCP Connection Pool Sizing
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Hibernate DDL Auto (validate against manually managed MySQL schema)
HIBERNATE_DDL_AUTO=validate

# Logging Directory
LOG_PATH=logs
